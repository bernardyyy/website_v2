// Updated getStaticPaths function to filter out draft projects and projectSequence calculation

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects
    .filter(project => !project.draft) // Filter out draft projects
    .map(project => ({
      params: { slug: project.slug },
    }));
}

const projectSequence = projects.filter(p => !p.draft); // Use only published projects

